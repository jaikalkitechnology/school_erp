# Jaikalki School ERP - example environment file.
# Copy to .env and adjust per environment.

# ---- App ----
APP_NAME=Jaikalki School ERP
COMPANY_NAME=Jaikalki Technology Pvt Ltd
DEBUG=true
ENVIRONMENT=development

# ---- Database ----
# Dev (default): SQLite for fast iteration. Switch the two URLs below for prod.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_URL_SYNC=sqlite:///./dev.db

# Prod (MySQL): uncomment & supply real credentials. The schema is utf8mb4.
# DATABASE_URL=mysql+aiomysql://root:Love1718@localhost:3306/db_school_jaikalki?charset=utf8mb4
# DATABASE_URL_SYNC=mysql+pymysql://root:Love1718@localhost:3306/db_school_jaikalki?charset=utf8mb4
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CORS (comma separated) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8080

# ---- Local file storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_WIDTH=1920
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,docx,xlsx

# Per-tenant storage limits (MB)
STORAGE_LIMIT_BASIC=5120
STORAGE_LIMIT_STANDARD=25600
STORAGE_LIMIT_PREMIUM=102400

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- SMS (MSG91) ----
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=JKLKSC

# ---- Email (SendGrid) ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@jaikalki.com

# ---- Firebase ----
# Path to the Firebase Admin SDK service-account JSON. Keep it out of git
# (it's in .gitignore). Get it from Firebase console → Project settings →
# Service accounts → Generate new private key.
FIREBASE_CREDENTIALS_PATH=./school-jaikalki-firebase-adminsdk-fbsvc-5b1fcf0080.json

# ---- Multi-tenant ----
DEFAULT_TENANT_LIMIT_STUDENTS=500
TRIAL_PERIOD_DAYS=30
PLATFORM_HOSTS=localhost,127.0.0.1,admin.jaikalki.com
