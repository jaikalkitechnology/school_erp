<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required on Android 13+ (API 33) so the OS actually shows
         heads-up / lock-screen notifications. FCM still delivers
         without this, but the user sees nothing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Transport driver foreground GPS pinger (Phase 26).
         FOREGROUND_SERVICE keeps the location loop alive when the driver
         locks their phone; the _LOCATION variant is required on Android
         14+ for location-type services. ACCESS_BACKGROUND_LOCATION lets
         us read GPS once the screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="jaikalki"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Default notification channel that FCM auto-displayed pushes
             (received while the app is backgrounded / killed) land in.
             Must match the channel id our flutter_local_notifications
             initialisation creates for foreground pushes — otherwise
             foreground and background notifications look different. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jaikalki_default" />

        <!-- Small status-bar icon + accent for pushes FCM shows while the
             app is in the background. Must be a white-on-transparent
             silhouette; the full-colour launcher icon renders as a white
             square. The same drawable is used for foreground banners. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Google Maps API key. The release build will refuse to draw
             tiles until a real key with the "Maps SDK for Android" API
             enabled is dropped here. The placeholder lets local builds
             compile; the user can override it via a Gradle property:
                 ./gradlew assembleDebug -PMAPS_API_KEY=AIza...
             Or just replace the literal below. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_background_service is currently disabled
             (BusTrackingService.init isn't called from main.dart).
             The plugin's own <service> entry still merges in from its
             own manifest, which is harmless if we never invoke
             startService(). We don't override foregroundServiceType
             any more — the manifest merger conflict that caused
             "processDebugMainManifest failed" is gone. -->
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
